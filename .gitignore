# AI agent files
ai/
# CLAUDE.md is tracked: it names the default working style for the repo, which
# belongs to everyone who clones it — same reasoning as .claude/skills/ below.
# The contents rather than the directory itself: git cannot re-include anything
# under an excluded directory, so `.claude` followed by `!.claude/skills/` would
# silently keep ignoring the skills.
.claude/*
# Skills are part of how the repo is worked on, so they belong to everyone who
# clones it — unlike the local settings and caches around them.
!.claude/skills/
.code-review-graph
.mcp.json
.mcpregistry_github_token
.mcpregistry_registry_token

# Go build artifacts
/bin/
/dist/

# Plugin
node_modules/
plugin/dist/
plugin/coverage/

